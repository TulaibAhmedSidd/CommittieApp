# Copy to .env (never commit .env)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Gmail address + Gmail *app password* (not your normal password)
SMTP_EMAIL=
SMTP_PASSWORD=
# Public URL of the app, used in email and WhatsApp links
APP_URL=https://committie-app.vercel.app
NEXT_PUBLIC_APP_URL=https://committie-app.vercel.app
# "log" = print emails to the server console instead of sending (use in development)
MAIL_MODE=log
